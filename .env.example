# Copy to .env.local and fill in. NEVER commit .env.local or share these values in chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for creating employee accounts and the bootstrap script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Minutes of inactivity before a signed-in user is signed out (5 to 720, default 60).
# IDLE_MINUTES=60
# Optional. Set to 1 on the live site, once the browser console shows no "Content Security Policy" warnings, to enforce the page-content policy.
# CSP_ENFORCE=1

# AI assistant (optional). Use ONE of the two services. Keep keys private, never in code or chat.
# Google Gemini (has a free tier, free tier = made-up data only): key from Google AI Studio
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_TIER=free        # set to paid ONLY after billing is switched on for the Google project
# GEMINI_THINKING=low     # minimal | low | medium | high | none  (lower = faster)
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash   # tried when the main model is busy or over its limit; none = off
# Anthropic (paid):
# ANTHROPIC_API_KEY=
# If both keys are set, choose with AI_PROVIDER=gemini or AI_PROVIDER=anthropic
# Optional: Anthropic model name (default claude-sonnet-5-5) and questions allowed per person per day (5 to 1000, default 100).
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ASSISTANT_DAILY_LIMIT=100
